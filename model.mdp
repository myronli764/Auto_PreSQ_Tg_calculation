define =
integrator = md
dt         = 0.001  ; fs
nsteps     = 50000000 ; 5ns
comm-grps  = system
energygrps =
;
nstxout = 0
nstvout = 0
nstfout = 0
nstlog  = 1000
nstenergy = 500
nstxout-compressed = 100000
compressed-x-grps  = system
;
annealing = single
annealing_npoints = 2
annealing_time = 0 1000 6000 11000 12000 17000 18000 23000;50000 60000
annealing_temp = 1800 1000 1000 1000 900 900 800 800
;
pbc = xyz
cutoff-scheme = Verlet
coulombtype   = PME
rcoulomb      = 1.0
fourierspacing= 0.12
pme-order     = 4
vdwtype       = cut-off
rvdw          = 1.0
DispCorr      = EnerPres
;
Tcoupl  = nose-hoover
tau_t   = 0.5
tc_grps = system
ref_t   = 1000
;
Pcoupl     = Parrinello-Rahman
pcoupltype = isotropic
tau_p = 20.0
ref_p = 1.0
compressibility = 4.5e-6
;
gen_vel  = no
gen_temp = 1000
gen_seed = -1
;
freezegrps  =
freezedim   =
constraints = none
